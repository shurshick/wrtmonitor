WRTMONITOR_PUBLIC_SERVER_URL=https://monitor.example.ru
WRTMONITOR_DATABASE_URL=postgresql+psycopg://wrtmonitor:change-me-db-password@postgres:5432/wrtmonitor
WRTMONITOR_BIND_HOST=0.0.0.0
WRTMONITOR_BIND_PORT=8080
WRTMONITOR_JWT_SECRET=change-me-long-random-secret
WRTMONITOR_DEFAULT_LOCALE=ru
WRTMONITOR_ALLOW_INSECURE_LOCAL=false
WRTMONITOR_ENABLE_API_DOCS=false
WRTMONITOR_ENABLE_METRICS=false
WRTMONITOR_LOGIN_RATE_LIMIT_ATTEMPTS=10
WRTMONITOR_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
WRTMONITOR_TELEMETRY_RETENTION_PER_DEVICE=100
WRTMONITOR_TELEMETRY_METRIC_RETENTION_DAYS=45
WRTMONITOR_COMMAND_HISTORY_RETENTION_DAYS=30
WRTMONITOR_COMMAND_HISTORY_MAX_PER_DEVICE=500
WRTMONITOR_EVENT_RETENTION_DAYS=90
WRTMONITOR_EVENT_MAX_PER_DEVICE=2000
WRTMONITOR_NOTIFICATION_ALLOW_PRIVATE_TARGETS=false
# WRTMONITOR_SMTP_HOST=smtp.example.ru
# WRTMONITOR_SMTP_PORT=587
# WRTMONITOR_SMTP_USERNAME=wrtmonitor@example.ru
# WRTMONITOR_SMTP_PASSWORD=change-me
# WRTMONITOR_SMTP_FROM=wrtmonitor@example.ru
# WRTMONITOR_SMTP_STARTTLS=true
POSTGRES_DB=wrtmonitor
POSTGRES_USER=wrtmonitor
POSTGRES_PASSWORD=change-me-db-password
