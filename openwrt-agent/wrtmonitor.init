#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
  if [ "$(uci -q get wrtmonitor.main.enabled 2>/dev/null)" != "1" ]; then
    echo "wrtmonitor is disabled"
    return 0
  fi

  procd_open_instance
  procd_set_param command /usr/bin/wrtmonitor-agent daemon
  # API calls can run for up to 30 seconds. Let the shell process its TERM trap
  # before procd escalates to SIGKILL, otherwise active child shells survive.
  procd_set_param term_timeout 40
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 0
  procd_set_param stderr 0
  procd_close_instance
}

service_triggers() {
  procd_add_reload_trigger wrtmonitor
}
