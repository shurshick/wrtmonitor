#!/bin/sh
set -eu
PATH="/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"
export PATH

# Set environment variables for the agent script path, name, and version
# shellcheck disable=SC2034
AGENT_SCRIPT="/usr/bin/wrtmonitor-agent"
# shellcheck disable=SC2034
AGENT_NAME="wrtmonitor-agent"
# shellcheck disable=SC2034
AGENT_VERSION="0.35.16"
# shellcheck disable=SC2034
CONFIG="wrtmonitor.main"

SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")"
case "$SCRIPT_PATH" in
    */*) SCRIPT_DIR="${SCRIPT_PATH%/*}" ;;
    *) SCRIPT_DIR="." ;;
esac

if [ -n "${WRTMONITOR_LIB_DIR:-}" ]; then
    LIB_DIR="$WRTMONITOR_LIB_DIR"
elif [ -d "$SCRIPT_DIR/lib" ]; then
    LIB_DIR="$SCRIPT_DIR/lib"
else
    LIB_DIR="/usr/lib/wrtmonitor"
fi

load_lib() {
    name="$1"
    path="$LIB_DIR/$name"
    if [ ! -r "$path" ]; then
        echo "FATAL: failed to load WrtMonitor library: $path" >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    . "$path" || {
        echo "FATAL: failed to load WrtMonitor library: $path" >&2
        exit 1
    }
}

load_lib common.sh
load_lib dependencies.sh
load_lib status.sh
load_lib update.sh
load_lib telemetry_system.sh
load_lib telemetry_maintenance.sh
load_lib telemetry_modules.sh
load_lib telemetry_vpn.sh
load_lib telemetry_network.sh
load_lib telemetry_wifi.sh
load_lib telemetry.sh
load_lib capabilities.sh
load_lib diagnostics.sh
load_lib idempotency.sh
load_lib transactions.sh
load_lib verification.sh
load_lib command_runtime.sh
load_lib command_wifi.sh
load_lib command_network.sh
load_lib command_firewall.sh
load_lib command_vpn.sh
load_lib command_system.sh
load_lib command_maintenance.sh
load_lib command_modules.sh
load_lib command_agent.sh
load_lib command_ssh.sh
load_lib commands.sh
load_lib api.sh

main "$@"
