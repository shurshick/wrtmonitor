wrtmonitor.main.interval=10
system.@system[0].hostname=OpenWrt
system.@system[0].timezone=MSK-3
network.wan.proto=dhcp
network.lan.proto=static
network.lan.ipaddr=192.168.31.1
dhcp.lan.start=100
dhcp.lan.limit=150
dhcp.lan.leasetime=12h
network.wrtmonitor_vlan_br_lan_42.device=br-lan
network.wrtmonitor_vlan_br_lan_42.vlan=42
mwan3.globals.enabled=1
mwan3.wrtmonitor_primary.interface=wan
mwan3.wrtmonitor_secondary.interface=wan2
mwan3.wrtmonitor_default.use_policy=wrtmonitor_policy
